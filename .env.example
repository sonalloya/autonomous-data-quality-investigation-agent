# ==============================================================================
# Environment Variables — Autonomous Data Quality Investigation Agent
# ==============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to source control.

# --- LLM Configuration (Phase 3+) ---
# Provider: Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=
# Optional — defaults to gemini-1.5-flash if not set
LLM_MODEL=gemini-1.5-flash

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (required in future phases) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dqa_db

# --- Logging ---
LOG_LEVEL=INFO
